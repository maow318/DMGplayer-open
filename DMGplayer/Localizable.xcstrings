    "图片太小（%lld×%lld）。请使用至少 512×512、推荐 1024×1024 的正方形图片。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The image is too small (%1$lld×%2$lld). Use a square image of at least 512×512; 1024×1024 is recommended."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像が小さすぎます（%1$lld×%2$lld）。512×512 以上の正方形画像を使用してください。1024×1024 を推奨します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미지가 너무 작습니다(%1$lld×%2$lld). 최소 512×512 정사각형 이미지를 사용하십시오. 1024×1024를 권장합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "图片太小（%1$lld×%2$lld）。请使用至少 512×512、推荐 1024×1024 的正方形图片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圖片太小（%1$lld×%2$lld）。請使用至少 512×512 的正方形圖片，建議使用 1024×1024。"
          }
        }
