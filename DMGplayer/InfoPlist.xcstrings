    "NSAppleEventsUsageDescription" : {
      "comment" : "Privacy - AppleEvents Sending Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DMGplayer needs to control Finder to configure the disk image window layout and icon positions."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスクイメージのウインドウレイアウトとアイコン位置を設定するため、DMGplayer は Finder を制御する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DMGplayer가 디스크 이미지의 윈도우 레이아웃과 아이콘 위치를 설정하려면 Finder를 제어해야 합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "DMGplayer 需要控制访达来设置磁盘映像的窗口布局与图标位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DMGplayer 需要控制 Finder，才能設定磁碟映像檔的視窗佈局和圖像位置。"
          }
        }
      }
    },
